{
  "name": "@mufw/example-auction",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:client": "vite",
    "build:client": "tsx scripts/build-client.ts && pnpm run check:bundle",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "dev:server": "MUFW_RPCS=Submit,Present,Dispatch,Representations,History,TravelTo,Replay tsx src/server.ts",
    "start:server": "tsx src/server.ts",
    "cert": "tsx scripts/dev-cert.ts",
    "test:live": "tsx test/live.ts",
    "test:live:wallet": "tsx test/walletLive.ts",
    "test:sync": "tsx test/syncLive.ts",
    "test:sync:restart": "tsx test/syncRestartLive.ts",
    "test:sync:failover": "tsx test/syncFailoverLive.ts",
    "compare:transports": "tsx scripts/compare-transports.ts"
  },
  "dependencies": {
    "effect": "^4.0.5",
    "@mufw/core": "workspace:*",
    "@mufw/rpc": "workspace:*",
    "@mufw/view-uhtml": "workspace:*",
    "@mufw/devtools": "workspace:*",
    "@mufw/test": "workspace:*",
    "@effect/platform-node": "^4.0.5",
    "@effect/platform-browser": "^4.0.5",
    "uhtml": "^4.7.1",
    "@statelyai/inspect": "^0.7.2",
    "vite": "^8.3.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "xstate": "^5.33.3"
  }
}
