{
  "name": "@mufw/core",
  "version": "0.1.0",
  "description": "SAM definitions on Effect 4: pure step, ports, local layers, nesting and composition, history, persistence and sync",
  "keywords": [
    "sam",
    "effect",
    "state-management",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trebh/microfw.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Trebh/microfw#readme",
  "bugs": {
    "url": "https://github.com/Trebh/microfw/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./sync": "./src/SyncEntry.ts"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./sync": {
        "types": "./dist/SyncEntry.d.ts",
        "default": "./dist/SyncEntry.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "effect": "^4.0.5"
  }
}
